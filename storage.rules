rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow anyone (public) to read/download files
      allow read: if true;

      // Guests may create only small JPEG/PNG receipt files in the receipts
      // directory. The client generates the filename, so overwrites are not
      // allowed through this rule.
      allow create: if request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png']
        && request.resource.name.matches('receipts/[A-Za-z0-9_-]+\\.(jpg|jpeg|png)');

      // Preserve authenticated administrative file management for now.
      allow update, delete: if request.auth != null;
    }
  }
}
